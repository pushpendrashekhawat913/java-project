<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>ShopSphere — Discover everyday essentials</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><header class="topbar"><a class="logo" href="${pageContext.request.contextPath}/products">Shop<span>Sphere</span></a>
<form class="search" action="${pageContext.request.contextPath}/products" method="get"><input name="q" value="<c:out value='${query}'/>" placeholder="Search products, brands..." aria-label="Search products"><button>Search</button></form>
<div class="top-actions"><a href="#products">Shop</a><a href="#about">About</a></div></header>
<main><section class="hero"><div><p class="eyebrow">THE EVERYDAY EDIT</p><h1>Good finds.<br><em>Better everyday.</em></h1><p class="hero-copy">Thoughtfully picked essentials for work, weekends and everything in between.</p><a class="cta" href="#products">Explore collection <span>↗</span></a></div><div class="hero-art"><div class="orb orb-one"></div><div class="orb orb-two"></div><div class="hero-note">CURATED FOR YOU<br><strong>01 / 06</strong></div><div class="hero-stamp">SS</div></div></section>
<section class="section-head" id="products"><div><p class="eyebrow">SHOP THE COLLECTION</p><h2>Popular right now</h2></div><span class="muted">Everyday essentials · Carefully selected</span></section>
<c:if test="${not empty query}"><p class="results">Showing results for “<c:out value='${query}'/>”</p></c:if>
<div class="product-grid"><c:forEach var="p" items="${products}"><article class="product-card"><div class="product-image"><c:if test="${p.discount gt 0}"><span class="discount">-${p.discount}%</span></c:if><img src="<c:out value='${p.imageUrl}'/>" alt="<c:out value='${p.name}'/>" loading="lazy"></div><div class="product-info"><p class="brand"><c:out value="${p.brand}"/></p><h3><c:out value="${p.name}"/></h3><p class="description"><c:out value="${p.description}"/></p><div class="price-row"><strong>₹<c:out value="${p.salePrice}"/></strong><c:if test="${p.discount gt 0}"><del>₹<c:out value="${p.price}"/></del></c:if><span class="stock"><c:choose><c:when test="${p.stock gt 0}">In stock</c:when><c:otherwise>Sold out</c:otherwise></c:choose></span></div><button class="add-btn" type="button" onclick="alert('Cart and checkout are the next development phase for this starter project.')">＋ Add to bag</button></div></article></c:forEach></div>
<c:if test="${empty products}"><div class="empty"><h3>No products found</h3><p>Try another search term.</p><a href="${pageContext.request.contextPath}/products">Clear search</a></div></c:if>
<section class="about" id="about"><p class="eyebrow">OUR POINT OF VIEW</p><h2>Less noise. More <em>good stuff.</em></h2><p>ShopSphere is a student e-commerce project built with Java, JSP, Servlets, JDBC and MySQL.</p></section></main>
<footer><a class="logo" href="${pageContext.request.contextPath}/products">Shop<span>Sphere</span></a><p>RTU Advanced Java Project · Learning build</p><p>© 2026 ShopSphere</p></footer></body></html>
